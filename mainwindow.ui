       QScrollBar::handle:vertical {
        background: #45475a; border-radius: 4px; min-height: 20px;
       }
       QScrollBar::handle:vertical:hover { background: #89b4fa; }
       QScrollBar:horizontal {
        background: #181825; height: 8px; border-radius: 4px;
